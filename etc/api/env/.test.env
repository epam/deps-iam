ENV=local

DATABASE_HOST=test-database
DATABASE_PORT=5432
DATABASE_DB=test_deps
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

AUTH_ENABLED=true
API_KEY=empty_key

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

DEFAULT_CUSTOMIZATION_URL=http://customuize

# Kafka
KAFKA_GROUP_ID=iam

EMAIL_INVITATIONS_ENABLED=true
SMTP_LOGIN=test_acc@mail.com
SMTP_PASSWORD=test-password
SMTP_HOST=test.host.smtp.com
SMTP_PORT=587

USER_GUIDE_LINK=http://localhost:8000/user-guide.pdf

VPN_DISCLAIMER="Please note that DEPS operates within the EPAM VPN environment. To access the platform please make sure you are connected to EPAM's VPN network before clicking the provided link."

EXTERNAL_URL=http://localhost:8000

CACHE_ENABLED=false
