ENV=local

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=iam
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# AUTH
AUTH_ENABLED=true
AUTH_VERIFY_SSL=false
FEATURE_PERSONAL_ORG=true
API_KEY_AUTH=true
USERINFO_ENDPOINT=https://keycloak-local/auth/realms/Test_realm/protocol/openid-connect/userinfo

# MESSAGING_MODE possible values: rabbitmq, transactional_outbox
MESSAGING_MODE=transactional_outbox

MESSAGE_POLLING_PERIOD=1.0
MESSAGE_POLLING_BATCH_SIZE=1

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps
RABBITMQ_DLX_PER_QUEUE=false

# Kafka
KAFKA_GROUP_ID=iam

EMAIL_INVITATIONS_ENABLED=false

EXTERNAL_URL=http://localhost:8000

CACHE_ENABLED=false

LOG_LEVEL=INFO

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-iam
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string
